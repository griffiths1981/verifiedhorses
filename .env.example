# Copy to .env. Nothing here is a live secret.

# Public site URL. No domain yet, so point this at the staging host.
BASE_URL=http://127.0.0.1:3000
AUTH_URL=http://127.0.0.1:3000
# Long random string. Required in a deployed environment.
AUTH_SECRET=

# Local default is SQLite. Production on Hostinger is MySQL, for example:
# DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/verifiedhorses
DATABASE_URL=file:./data/dev.db

# Preview gate. Leave blank locally. Set both on the private staging site.
PREVIEW_BASIC_AUTH_USER=
PREVIEW_BASIC_AUTH_PASSWORD=

# Staging stays out of search indexes. Set true only for a public launch.
ALLOW_INDEXING=false

# Required before cron or the bot API will run.
CRON_SECRET=
ADMIN_API_TOKEN=

# Used only when the database has no admin user yet.
ADMIN_INITIAL_PASSWORD=
# Set to false to skip example horses and example accounts.
SEED_DEMO=true

CONTACT_EMAIL=hello@verifiedhorses.example
LEGAL_ENTITY_NAME=
MAIL_FROM=hello@verifiedhorses.example

# Optional. Without a key, mail is written to the outbox and the log.
BREVO_API_KEY=

# Optional. Without keys, identity and advert fees use the on-screen demo flow.
# Use Stripe test keys only. Never put live keys on this staging build.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Video VPS. Leave blank to store uploads on this machine without transcoding.
VIDEO_SERVICE_URL=
VIDEO_PUBLIC_URL=
VIDEO_API_TOKEN=
VIDEO_CALLBACK_SECRET=

# Optional. Events are always stored for the bot to poll.
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=

# Home page "near you" point until a buyer sets a postcode.
DEFAULT_OUTCODE=YO1
