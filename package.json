{
  "name": "verifiedhorses",
  "version": "0.1.0",
  "private": true,
  "description": "VerifiedHorses, a trust-led UK horse marketplace. Staging build.",
  "license": "UNLICENSED",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-client.cjs && next build",
    "start": "node server.js",
    "test": "vitest run && node --test video-service/test/*.test.js",
    "postinstall": "node scripts/generate-client.cjs",
    "db:migrate": "node scripts/prisma.cjs migrate dev",
    "db:seed": "node scripts/seed-if-empty.cjs",
    "db:sync-mysql": "node scripts/sync-mysql-schema.cjs"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "16.6.1",
    "esbuild": "0.28.2",
    "express": "5.3.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "23.2.0",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "better-sqlite3": "13.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vitest": "3.2.7"
  },
  "overrides": {
    "effect": "3.22.5",
    "tinypool": "2.2.0"
  }
}
